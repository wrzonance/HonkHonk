{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "7 days",
  "automerge": false,
  "labels": ["dependencies"],
  "commitMessagePrefix": "chore(deps):",
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "groupName": "cargo-deps"
    },
    {
      "description": "tiny-skia is a dev-dependency pinned `=` to iced's transitive version; bump it together with iced, never on its own",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["tiny-skia"],
      "enabled": false
    },
    {
      "description": "sha2 0.11 (digest 0.11) drops LowerHex on the output array; hold until #266 lands",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["sha2"],
      "allowedVersions": "<0.11"
    },
    {
      "matchManagers": ["github-actions"],
      "labels": ["ci"],
      "commitMessagePrefix": "chore(ci):",
      "groupName": "github-actions"
    }
  ]
}
